# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string.
# If you use the provided docker-compose.yml as-is, this value works unchanged.
DATABASE_URL="postgresql://grocery:grocery@localhost:5432/grocery_pos?schema=public"

# Server
PORT=4000
NODE_ENV=development

# CORS: comma-separated list of origins allowed to call this API
# (your Vite dev server default is included below)
CORS_ORIGIN="http://localhost:5173"

# Auth secrets — generate real random values before deploying anywhere,
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET="dev-only-change-me-access"
JWT_REFRESH_SECRET="dev-only-change-me-refresh"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN_DAYS=30

# Seed script: the first admin account it creates
SEED_ADMIN_EMAIL="admin@store.test"
SEED_ADMIN_PASSWORD="ChangeMe123!"
