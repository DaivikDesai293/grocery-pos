    "@react-navigation/native-stack": "^6.9.0",
    "axios": "^1.7.7",
    "expo": "~57.0.0",
    "expo-asset": "~57.0.17",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "^0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
