# Copy this file to .env and adjust only if the defaults in src/api/config.js
# don't fit your setup. Simulators/emulators work with NO .env at all.
#
# A PHYSICAL phone or tablet is on its own Wi-Fi connection — it can't reach
# "localhost", because that would mean the phone itself, not your computer.
# It needs your computer's real LAN IP address instead. Find it with:
#   Mac:     ipconfig getifaddr en0
#   Windows: ipconfig            (look for "IPv4 Address" on your Wi-Fi adapter)
#   Linux:   hostname -I
# Then make sure your phone is on the SAME Wi-Fi network as your computer,
# and that the backend is started with it listening on that network (the
# default `npm run dev` already listens on all interfaces).
EXPO_PUBLIC_API_URL="http://10.0.0.178:4000/api"